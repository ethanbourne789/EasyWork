# ============================================================================
# Edge Function Secrets 模板
# ----------------------------------------------------------------------------
# 用途：通过 `supabase secrets set --env-file supabase/.env.secrets` 注入到
#       所有 Edge Functions 的运行时环境变量。
#
# 使用方法：
#   1. 复制此文件为 supabase/.env.secrets（已 gitignore，不会提交）
#   2. 填入真实值
#   3. 执行: supabase secrets set --project-ref <ref> --env-file supabase/.env.secrets
#
# 安全：真实 .env.secrets 切勿提交到 git；密钥泄露后应立即在 Dashboard 轮换。
# ============================================================================

# ---------- Supabase 平台自动注入（无需手动设置） ----------
# 以下变量 Supabase 平台会自动注入到 Edge Function 运行时，无需在此设置：
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#   SUPABASE_DB_URL
#   SUPABASE_JWKS
#   SUPABASE_PUBLISHABLE_KEYS
#   SUPABASE_SECRET_KEYS

# ---------- 手动设置的项目密钥 ----------

# SERVICE_ROLE_KEY: 等于 SUPABASE_SERVICE_ROLE_KEY 的值。
# 代码中 fetch-mail 定时分支用此名校验 Authorization 头。
# 从 Dashboard > Settings > API > service_role key 复制。
SERVICE_ROLE_KEY=your-service-role-key-here

# EMAIL_ENC_KEY: 邮箱密码加密密钥（256-bit hex）。
# 用于 encrypt_email_password / decrypt_email_password RPC 函数。
# 生成方法: openssl rand -hex 32  或  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 一旦设置并加密了存量密码，此密钥不可更改（否则所有已加密密码无法解密）。
EMAIL_ENC_KEY=your-256-bit-hex-encryption-key
